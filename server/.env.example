# Server environment — server-side only. Never sent to the browser.
# Copy to server/.env and fill in. server/.env is gitignored.
# The server will not start while your_api_key_here or change_me remain below.
# Full instructions: DEPLOY.md section 5.

# Inference engine API key (REQUIRED). Get a free one at https://console.groq.com
# → API Keys → Create API Key. The endpoint is OpenAI-compatible, so any
# OpenAI-compatible provider works if you also set LLM_BASE_URL below.
LLM_API_KEY=your_api_key_here

# Backend listen port. 4309 is this POC's assigned port (frontend pairs on 3309).
# In production pm2 passes PORT inline, which overrides this.
PORT=4309

# Passwords for the two accounts created on first boot. Set both before a public
# deployment; they only apply when server/data/users.json does not exist yet.
ADMIN_PASSWORD=change_me
ENGINEER_PASSWORD=change_me

# Signing secret for login tokens. Generate one with: openssl rand -hex 48
JWT_SECRET=change_me

# Organisation name printed on generated tenders and vendor enquiry letters.
# When empty, documents use the ship builder named in the source or a placeholder.
ORG_NAME=

# Largest accepted upload per file. Keep below nginx client_max_body_size.
MAX_UPLOAD_MB=100

# Optional overrides (sensible defaults are built in):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Scanned pages read per document (each is one vision call). Default 10.
# EXTRACT_MAX_VISION_PAGES=10
