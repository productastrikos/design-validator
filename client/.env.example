# Client environment (Vite). Every VITE_* value is inlined into the public
# bundle — never put a secret here.
#
# Leave both EMPTY for local development: the client then calls the relative
# "/api" and the Vite dev proxy forwards it to the backend (vite.config.mjs).
#
# For a deployed build, point them at the backend subdomain. One backend, one
# port — REST and websockets share the same host.
VITE_API_URL=
VITE_SOCKET_URL=

# Example (production):
# VITE_API_URL=https://designvalidator-api.astrikos.xyz:8443
# VITE_SOCKET_URL=https://designvalidator-api.astrikos.xyz:8443

