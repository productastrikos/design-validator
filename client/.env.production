# Production build — cross-service URLs only. No secrets belong in this file:
# everything prefixed VITE_ is inlined into the JS bundle and is public.
#
# One backend, one port: REST and websockets share the same host (see
# deployment_context.md §2).
VITE_API_URL=https://designvalidator-api.astrikos.xyz:8443
VITE_SOCKET_URL=https://designvalidator-api.astrikos.xyz:8443
